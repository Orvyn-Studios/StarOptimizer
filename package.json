{
  "name": "staroptimizer",
  "version": "2.1.0",
  "description": "Diagnóstico local y ajustes reversibles para Windows",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "test:ui": "node test/ui.cjs",
    "test:workflow": "node test/workflow.cjs",
    "test:nova": "node test/nova.cjs",
    "test:scan": "node test/scan-flow.cjs",
    "test:measure": "node test/measure-ui.cjs",
    "test:live": "node test/live-recommendations.cjs",
    "dist": "electron-builder --win portable --x64",
    "test:windows:smoke": "node scripts/verify-windows.cjs",
    "dist:store": "electron-builder --win appx --x64"
  },
  "keywords": [],
  "author": "StarOptimizer",
  "license": "UNLICENSED",
  "type": "commonjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3"
  },
  "private": true,
  "build": {
    "appId": "com.staroptimizer.desktop",
    "productName": "StarOptimizer",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "portable",
        "appx"
      ],
      "signExecutable": false,
      "icon": "src/assets/icon.ico"
    },
    "portable": {
      "artifactName": "StarOptimizer-${version}-portable.exe"
    },
    "appx": {
      "identityName": "Snow099.StarOptimizer",
      "publisher": "CN=6B89B3B6-A665-4A0C-8E0F-15C4A076AC42",
      "publisherDisplayName": "Snow099",
      "displayName": "StarOptimizer",
      "applicationId": "StarOptimizer",
      "backgroundColor": "transparent",
      "languages": [
        "es-ES",
        "en-US"
      ],
      "customManifestPath": "appxmanifest.xml",
      "artifactName": "StarOptimizer-${version}.appx"
    }
  }
}

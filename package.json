{
  "name": "staroptimizer",
  "version": "0.6.2",
  "description": "Diagnóstico local y ajustes reversibles para Windows",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "prestart": "node scripts/build-native.cjs",
    "build:native": "node scripts/build-native.cjs",
    "test": "node --test test/*.test.cjs",
    "test:ui": "node test/ui.cjs",
    "test:workflow": "node test/workflow.cjs",
    "test:nova": "node test/nova.cjs",
    "test:scan": "node test/scan-flow.cjs",
    "test:measure": "node test/measure-ui.cjs",
    "test:live": "node test/live-recommendations.cjs",
    "dist": "electron-builder --win portable --x64 --publish never",
    "dist:signed": "electron-builder --win portable --x64 --publish never -c.forceCodeSigning=true && powershell -NoProfile -NonInteractive -File scripts/verify-signatures.ps1"
  },
  "keywords": [],
  "author": "StarOptimizer",
  "license": "UNLICENSED",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3"
  },
  "private": true,
  "build": {
    "beforePack": "scripts/build-native.cjs",
    "asarUnpack": ["src/native/*.exe"],
    "appId": "com.staroptimizer.desktop",
    "productName": "StarOptimizer",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "portable",
      "signExecutable": true,
      "signExts": [".dll"],
      "signtoolOptions": {
        "signingHashAlgorithms": ["sha256"]
      },
      "icon": "src/assets/icon.ico"
    },
    "portable": {
      "artifactName": "StarOptimizer-${version}-portable.exe"
    }
  }
}

